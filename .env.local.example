# ---------------------------------------------------------------------------
# UYARI: VITE_ önekli her değişken Vite tarafından client bundle'ına DÜZ METİN
# olarak gömülür ve tarayıcıdan okunabilir. Buraya yalnızca herkese açık
# olmasında sakınca olmayan değerler yazın.
# ---------------------------------------------------------------------------

# Supabase — Supabase Dashboard > Settings > API adresinden alınır
# publishable/anon key public-by-design'dır; asıl koruma RLS politikalarıdır.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key_here

# ---------------------------------------------------------------------------
# Yalnızca sunucu tarafı (VITE_ öneki YOK — bundle'a gömülmez)
# ---------------------------------------------------------------------------

# Gemini — Google AI Studio'dan alınır. Sadece api/gemini.ts okur.
GEMINI_API_KEY=your_gemini_api_key_here

# /api/gemini proxy'sinin gelen Supabase JWT'sini doğrulamak için kullandığı
# değerler. Vercel'de VITE_ önekli olanlar zaten tanımlıysa bunlar opsiyoneldir.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_publishable_key_here
